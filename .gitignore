# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# The demo video project: 9 MB of narration audio and rendered stills that the
# app never serves and a deployment never reads. The video is uploaded to the
# submission, so tracking its sources here would put the whole of it in every
# clone of a repo whose own public/ directory is 99 KB.
/videos/

# Narration takes and rendered demos written straight to the repo root by the
# video tooling. The app's own audio is generated per request and never stored,
# and the finished video is uploaded to the submission rather than cloned with
# the repo, so media here is always output rather than source.
/*.mp3
/*.mp4

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
