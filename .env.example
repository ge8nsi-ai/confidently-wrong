# Server-side only. Never prefix with NEXT_PUBLIC_. Never commit .env.local.
# The app works fully without this key: refutations fall back to hand-written text,
# and speech falls back to the browser's on-device voice.
MISTRAL_API_KEY=

# Optional overrides (defaults shown)
# MISTRAL_MODEL=ministral-3b-latest
# MISTRAL_TTS_MODEL=voxtral-mini-tts-latest
# MISTRAL_TRANSCRIBE_MODEL=voxtral-mini-latest
# MISTRAL_TTS_VOICE=gb_oliver_neutral
